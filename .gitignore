# ── Nothing heavy in OneDrive ────────────────────────────────────────────
# Build output and runtimes stay out of git entirely.
# See docs/ARCHITECTURE.md → "Where things live"

# Rust build output — redirected by .cargo/config.toml, ignored as a safety net
target/
**/target/

# Node — redirected by a junction, ignored as a safety net
node_modules/
**/node_modules/

# Tauri build artifacts
src-tauri/target/
# NOT `src-tauri/gen/`. Excluding the directory kills upstream's
# `!src-tauri/gen/android/` further down, because git cannot re-include a file
# whose parent directory is excluded - and that silently untracked the 42 files
# of the Android project, so the Android CI job could not find Cargo.toml.
# Upstream's `src-tauri/gen/*` below ignores the generated schemas and keeps the
# Android project, which is what we want too.

# Frontend build output
dist/
dist-ssr/
build/
.vite/

# ── Binaries and models ──────────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib
*.msi
*.nsis
*.onnx
*.safetensors
*.pt
*.bin
ai-models/

# ── Local runtime data ───────────────────────────────────────────────────
catalog.db
catalog.db-*
thumbnails/
*.rrdata

# ── Editors and OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ── OneDrive junk ────────────────────────────────────────────────────────
*.tmp
~$*

# ══ Inherited from RapidRAW upstream ══════════════════════════════════
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

/target/
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# dynamic libraries downloaded by 'ort' crate at build time
src-tauri/resources/libonnxruntime.so
src-tauri/resources/libonnxruntime.dylib
src-tauri/resources/onnxruntime.dll
src-tauri/gen/*
!src-tauri/gen/android/
# Ignore Android assets generated by Tauri
src-tauri/gen/android/app/src/main/assets/
src-tauri/libs/

**/keystore.properties
**/keystore.jks
**/key.properties

# bench/replay.js result dumps
bench/out/
.compare/

# ── Private to this machine ──────────────────────────────────────────────
# Working rules, agent tooling and one-time setup. None of it is part of the
# application, and none of it should reach a contributor's clone.
setup.ps1

# Claude Code: the repo guide, its local overrides, and the per-machine
# settings, agents, skills and command definitions under .claude/. No leading
# slash, so these are ignored at any depth.
CLAUDE.md
CLAUDE.local.md
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
patch.txt
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# dynamic libraries downloaded by 'ort' crate at build time
src-tauri/resources/libonnxruntime.so
src-tauri/resources/libonnxruntime.dylib
src-tauri/resources/onnxruntime.dll
src-tauri/gen/*
!src-tauri/gen/android/
# Ignore Android assets generated by Tauri
src-tauri/gen/android/app/src/main/assets/
src-tauri/libs/

**/keystore.properties
**/keystore.jks
**/key.properties

# bench/replay.js result dumps
bench/out/
